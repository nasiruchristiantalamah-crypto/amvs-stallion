# Environment / secrets — copy .env.example to .env locally; never commit .env
.env

# Python bytecode/cache
__pycache__/
*.pyc
*.pyo

# Local dev database (SQLite fallback when DATABASE_URL isn't set — see db/database.py)
*.db

# client.yaml holds one client's real, machine-specific data folder path
# (local development only — see engine/clients.py's load_client() and
# README.md). clients/<id>/assumptions.yaml is the counterpart that IS
# committed — name, currency, non-life workbook filenames, assumption
# overrides, reinsurance — nothing machine-specific, and it's what makes a
# client "exist" (see list_clients()), so excluding client.yaml never hides
# a whole client. clients/_template/client.yaml.example is unaffected by
# this rule (different filename) and stays committed as the onboarding template.
clients/*/client.yaml

# Generated report output — regenerated on demand by excel_exporter.py /
# word_exporter.py, not source of truth.
*.xlsx
*.docx

# EXCEPTION: the NIC's own published risk-free rate yield curve
# (data/yield_curve.py) — a public regulatory document (not private client
# data), committed so non-life discounting works on Railway and every dev
# machine without depending on a real person's local OneDrive path. See
# data/yield_curve.py's module docstring for provenance.
!data/nic_curves/*.xlsx

# OS/editor cruft
.DS_Store
Thumbs.db

# Ad-hoc debug logs from local smoke-testing (uvicorn stdout/stderr redirects)
*.log
