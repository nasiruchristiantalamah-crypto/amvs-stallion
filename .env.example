# ============================================================
# AMVS — environment variables
# ============================================================
# Copy this file to .env for local development (never commit the real
# .env — it holds secrets). On Railway, set these under the service's
# Variables tab instead of using a .env file at all.

# --- Database ------------------------------------------------
# Full SQLAlchemy connection string. On Railway, attach a PostgreSQL
# plugin to this service and it injects DATABASE_URL automatically — you
# don't need to set this by hand there. Locally, if left unset, the API
# falls back to a SQLite file (amvs_dev.db) so it still boots without a
# Postgres server running (see db/database.py) — fine for development,
# NOT for production.
DATABASE_URL=postgresql://user:password@localhost:5432/amvs

# --- Auth ------------------------------------------------------
# Signs and verifies JWT access tokens (auth/security.py). Must be a
# long, random, secret value in production — anyone who has it can forge
# a valid login for any user. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string

# Minutes before an issued access token expires. Optional — defaults to
# 480 (8 hours) if omitted.
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- CORS --------------------------------------------------------
# Comma-separated list of origins allowed to call this API from a
# browser (your dashboard's deployed URL(s)). Optional — defaults to "*"
# (allow any origin) only for local development; set this explicitly in
# production.
ALLOWED_ORIGINS=https://your-dashboard.example.com,http://localhost:3000

# --- Server (Railway sets PORT automatically — see Procfile) ---
# PORT=8000
